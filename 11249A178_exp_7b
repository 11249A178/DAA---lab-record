#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Edge structure
struct Edge {
    int src, dest, weight;
};

// Disjoint Set (Union-Find)
int parent[MAX];

int find(int i) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

void unionSet(int i, int j) {
    int a = find(i);
    int b = find(j);
    parent[a] = b;
}

// Sorting edges by weight
int compare(const void *a, const void *b) {
    struct Edge *e1 = (struct Edge *)a;
    struct Edge *e2 = (struct Edge *)b;
    return e1->weight - e2->weight;
}

void kruskal(struct Edge edges[], int n, int E) {
    struct Edge mst[MAX];
    int e = 0; // MST edge count
    int i = 0; // sorted edges index

    // Sort edges by weight
    qsort(edges, E, sizeof(edges[0]), compare);

    // Initialize parent
    for (int v = 0; v < n; v++)
        parent[v] = v;

    while (e < n - 1 && i < E) {
        struct Edge next = edges[i++];

        int x = find(next.src);
        int y = find(next.dest);

        // If no cycle
        if (x != y) {
            mst[e++] = next;
            unionSet(x, y);
        }
    }

    // Print MST
    printf("Edge \tWeight\n");
    for (int i = 0; i < e; i++) {
        printf("%d - %d \t%d\n",
               mst[i].src, mst[i].dest, mst[i].weight);
    }
}

int main() {
    int n, E;

    printf("Enter number of vertices and edges: ");
    scanf("%d %d", &n, &E);

    struct Edge edges[E];

    printf("Enter edges (src dest weight):\n");
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].src,
              &edges[i].dest,
              &edges[i].weight);
    }

    kruskal(edges, n, E);

    return 0;
}
